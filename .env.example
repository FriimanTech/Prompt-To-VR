# ==============================================================================
# Prompt-To-Native-VR local env template
# Copy this file to `.env` at the repo root and fill in the blanks.
# ==============================================================================

# --- Provider API keys (required to run the full pipeline) --------------------
ANTHROPIC_API_KEY=
# Optional: ChatGPT (OpenAI) fallback used automatically when Claude is
# missing / errors out. Leave blank to disable the fallback.
OPENAI_API_KEY=
GOOGLE_API_KEY=
TRIPO_API_KEY=

# --- Optional local SDK overrides --------------------------------------------
# Leave blank to rely on the system VULKAN_SDK / OpenXR active runtime.
OPTIONAL_VULKAN_SDK_PATH=
# Example: C:\Program Files\Oculus\Support\oculus-runtime\oculus_openxr_64.json
OPTIONAL_OPENXR_RUNTIME_HINT=

# --- Local service ports ------------------------------------------------------
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8787
WEB_PORT=5173

# --- Model selection (verified Sep 2026) -------------------------------------
# Hardest gameplay planning + hardest C++ generation.
CLAUDE_HARD_MODEL=claude-opus-4-7
# Lighter planning / routine transforms / supportive code generation.
CLAUDE_LIGHT_MODEL=claude-sonnet-4-6
#
# ChatGPT fallback tiers, used when Claude is missing or errors out. Both are
# gpt-5.6-sol (~1.05M context, 128K max output); what separates them is
# REASONING EFFORT, not the model:
#   hard  -> build_spec, the master planner every later stage derives from.
#   light -> asset_manifest, which decides which assets get rigged and
#            animated (~30 and ~20 Tripo credits each). Deliberately
#            'medium' rather than 'low': saving a fraction of a cent on the
#            call that spends the credits is a false economy.
# gpt-5.6 accepts: none | low | medium (default) | high | xhigh | max.
# NOTE 'minimal' was valid on gpt-5 and is GONE in 5.6 -- the orchestrator
# rejects it at startup rather than letting it 400 mid-run.
OPENAI_HARD_MODEL=gpt-5.6-sol
OPENAI_LIGHT_MODEL=gpt-5.6-sol
OPENAI_HARD_REASONING_EFFORT=high
OPENAI_LIGHT_REASONING_EFFORT=medium
# Gemini native image model for reference images (Stage 5).
# Imagen 4 endpoints (IMAGEN_MODEL=imagen-4.0-generate-001) are discontinued
# after 2026-08-17. Google recommends gemini-3.1-flash-image via generate_content.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Tripo image-to-3D checkpoint. Leave blank for v3.1-20260211 (the latest and
# best quality). V3 accepts only: v3.1-20260211, v3.0-20250812, v2.5-20250123,
# P1-20260311 -- anything else is rejected at startup.
TRIPO_MODEL_VERSION=
# Tripo V3 base URL. Leave blank for the international endpoint
# (https://openapi.tripo3d.ai/v3). Set to https://openapi.tripo3d.com/v3 for a
# China-mainland account; a key only validates in its own region.
TRIPO_BASE_URL=

# --- Agents SDK stages: model + reasoning effort -----------------------------
# The five agentic stages each run their OWN agent on the Responses API, so
# each gets its own model and effort. All default to gpt-5.6-sol; the effort
# is where the per-stage judgement lives. Leave these blank/absent to use the
# defaults documented in apps/orchestrator/ptv_orchestrator/settings.py.
#
# npc_plan (high) -- decides whether a character needs a rig at all, which
#   is the most expensive question in the pipeline.
# mechanic_plan (high) -- authors the CodeTasks ALL of codegen works from, so
#   a misclassification costs a whole generate-and-compile cycle.
# scene_spec (medium) -- a mapping task (assets + mechanics -> entities),
#   not deep reasoning. Lower to 'low' for faster runs on simple scenes.
# world_generation (high) -- writes IWorldBuilder C++ that must compile;
#   'medium' risks first-try compile failures. 'xhigh' for max quality.
# code_generation (high) -- the hardest C++ in the pipeline. This one MUST
#   stay explicit: the Agents SDK infers effort from the model NAME when an
#   agent passes none, and it infers 'none' for gpt-5.6-sol, which would
#   silently strip reasoning from the whole stage.
NPC_PLAN_MODEL=gpt-5.6-sol
NPC_PLAN_REASONING_EFFORT=high
MECHANIC_PLAN_MODEL=gpt-5.6-sol
MECHANIC_PLAN_REASONING_EFFORT=high
SCENE_SPEC_MODEL=gpt-5.6-sol
SCENE_SPEC_REASONING_EFFORT=medium
WORLD_MODEL=gpt-5.6-sol
WORLD_REASONING_EFFORT=high
CODEGEN_MODEL=gpt-5.6-sol
CODEGEN_REASONING_EFFORT=high

# --- Multi-agent code generation (Stage 8) -----------------------------------
# How many OpenAI Agents SDK sessions may be in flight at the same time.
# Each worker claims one CodeTask from the shared ``codegen_board.json``
# ledger, runs one ``Runner.run_sync`` session with the hosted
# ``WebSearchTool`` enabled (no cap on search calls), writes the
# multi-file result, then claims the next eligible task. Default 3.
CODEGEN_MAX_PARALLEL_AGENTS=3

# --- SceneSpec stage parallelism (Stage 4) -----------------------------------
# SceneSpec issues one structured-output LLM call per BuildSpec scene.
# A long user prompt (e.g. a 945-line "GREEN LANTERN: WILLPOWER VR"
# brief) can describe 10-15+ distinct scenes. Running them serially
# made the stage appear to hang for 15-25 minutes. The orchestrator
# now fans these calls out across a thread pool capped by this knob.
SCENE_SPEC_MAX_PARALLEL_WORKERS=3

# --- LLM output budgets ------------------------------------------------------
# Caps the maximum tokens an LLM call may emit per stage. These exist
# so long user prompts (e.g. a 900+ line BuildSpec) do not silently
# truncate downstream artifacts (MechanicPlan, SceneSpec, CodeTask).
#
# OpenAI: gpt-5.6 and other reasoning models charge the SAME budget for
# invisible reasoning tokens AND visible output. OpenAI recommends
# reserving at least 25K tokens; we default to 96K so even very large
# structured outputs (a MechanicPlan with 30+ items) fit comfortably.
# If a single call still truncates, the client AUTO-RETRIES once with a
# doubled cap, up to ``OPENAI_MAX_TOKENS_CEILING`` (128K, which is exactly
# gpt-5.6-sol's max output).
OPENAI_MAX_TOKENS=96000
OPENAI_MAX_TOKENS_CEILING=128000
# Claude: ``max_tokens`` caps visible output only (no hidden reasoning
# budget). 32K is the Claude Opus 4.7 default output limit and is
# plenty for a complex MechanicPlan or SceneSpec.
CLAUDE_MAX_TOKENS=32000

# --- LLM request timeouts ----------------------------------------------------
# Per-HTTP-request timeout in seconds. The OpenAI / Anthropic SDK
# defaults are 10 minutes (600s); we cap at 5 minutes so a stalled
# connection cannot silently wedge a pipeline stage. A reasoning model
# on a complex schema finishes well inside this budget. Raise this
# only if you genuinely see legitimate timeouts (slow proxy / very
# large outputs) -- raising it is NOT a way to fix the "Resume just
# sits at running" symptom, which is now solved by per-scene
# idempotent reuse of any scene_spec.<id>.json that's already on disk.
OPENAI_REQUEST_TIMEOUT_SECONDS=300
CLAUDE_REQUEST_TIMEOUT_SECONDS=300

# --- C++ toolchain ------------------------------------------------------------
# Absolute path to your vcpkg checkout (contains scripts/buildsystems/vcpkg.cmake).
VCPKG_ROOT=
# CMake generator (kept matched to Visual Studio Community 2026).
CMAKE_GENERATOR=Visual Studio 18 2026
CMAKE_GENERATOR_PLATFORM=x64
CMAKE_BUILD_CONFIG=Release
