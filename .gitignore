!apps/web/.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.keystore.properties
keystore.properties
signing.properties
local.properties
id_rsa*
id_ed25519*
*.ppk
.npmrc
.pypirc
.netrc
credentials.json
service-account*.json
*-service-account.json
SECRET_AUDIT_REPORT.md

