# ---------------------------------------------------------------------------
# C++ / CMake / vcpkg
# ---------------------------------------------------------------------------
build/
builds/
# Android NDK staging, relocated here so FetchContent stamp paths stay under
# Windows' 260-character MAX_PATH (see engine/android/app/build.gradle).
.cxx/
out/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
CMakeUserPresets.json
Testing/
compile_commands.json
vcpkg_installed/
**/vcpkg_installed/
_deps/
*.obj
*.o
*.lib
*.a
*.pdb
*.ilk
*.idb
*.ipch
*.exp
*.tlog
*.exe
*.dll
*.so

# CMake build trees (engine + offline world-gen host)
engine/build/
engine/worldgen/build/

# ---------------------------------------------------------------------------
# Android / Gradle (Quest APK packaging)
# ---------------------------------------------------------------------------
.gradle/
.externalNativeBuild/
captures/
*.apk
*.aab
*.ap_
*.dex
*.idsig
*.hprof
# Gradle wrapper is required to build the Quest APK -- keep it.
!engine/android/gradle/wrapper/gradle-wrapper.jar

# ---------------------------------------------------------------------------
# Generated content (recreated by the pipeline)
# ---------------------------------------------------------------------------
# Per-project workspaces (artifacts / builds / logs / paid API outputs)
projects/*/
!projects/.gitkeep
# LLM-generated C++
engine/generated/*
!engine/generated/CMakeLists.txt
!engine/generated/**/.gitkeep
# Compiled shaders / compressed textures produced at build time
*.spv
!**/fixtures/**/*.spv

# ---------------------------------------------------------------------------
# Logs, caches, temp
# ---------------------------------------------------------------------------
*.log
logs/
.cache/
tmp/
temp/
*.tmp
*.bak
*.bak-*
*.orig
*.swp
*~

# ---------------------------------------------------------------------------
# IDE / editors
# ---------------------------------------------------------------------------
.vs/
*.user
*.suo
*.sln.docstates
.idea/
.vscode/
!.vscode/settings.json
.history/

