{
  "$defs": {
    "AttachmentRef": {
      "additionalProperties": false,
      "description": "Ride on a point of another entity instead of standing on your own.\n\nThis is how a separately-generated weapon ends up in a separately-\ngenerated character's hand. Tripo sometimes returns \"goblin holding a\nrifle\" as one mesh and sometimes returns two, and only the second case\nneeds this -- but it is common enough that a scene with no way to express\nit cannot build half the games it is asked for.",
      "properties": {
        "anchor": {
          "default": "grip",
          "description": "Socket or rig joint on the parent to follow. Named sockets ('muzzle', 'grip') win; otherwise the runtime matches a joint, including loose aliases like 'hand_r' / 'hand_l' / 'head' that work regardless of what Tripo named the bones.",
          "maxLength": 64,
          "title": "Anchor",
          "type": "string"
        },
        "entity_id": {
          "description": "The entity to ride on, by scene entity id.",
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
          "title": "Entity Id",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Vec3",
          "description": "Offset from the anchor, in the anchor's space (metres)."
        },
        "rotation": {
          "$ref": "#/$defs/QuatXYZW",
          "description": "Rotation relative to the anchor."
        }
      },
      "required": [
        "entity_id"
      ],
      "title": "AttachmentRef",
      "type": "object"
    },
    "EntitySpec": {
      "additionalProperties": false,
      "properties": {
        "attached_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttachmentRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parent this entity to a point on another one. Its transform is then driven by the parent every frame, so the authored 'transform' above is only its pose before the first update."
        },
        "faction": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactionProps"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Which side this entity is on. Required for anything that selects targets or can be targeted."
        },
        "health": {
          "anyOf": [
            {
              "$ref": "#/$defs/HealthProps"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Give this entity hit points. Required for anything that can be killed or can take damage."
        },
        "id": {
          "description": "Snake-case identifier, max 64 chars.",
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "mechanic_bindings": {
          "items": {
            "$ref": "#/$defs/MechanicBinding"
          },
          "title": "Mechanic Bindings",
          "type": "array"
        },
        "mesh": {
          "anyOf": [
            {
              "$ref": "#/$defs/MeshRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        },
        "physics": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhysicsProps"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Tags",
          "type": "array"
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "EntitySpec",
      "type": "object"
    },
    "FactionProps": {
      "additionalProperties": false,
      "description": "Which side an entity fights for.\n\nNeeded so enemies engage the player's allied NPCs and not only the\nplayer. Use short stable ids: 'player', 'enemy', 'ally', 'wildlife'.",
      "properties": {
        "hostile_to": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Hostile To",
          "type": "array"
        },
        "id": {
          "default": "neutral",
          "maxLength": 32,
          "title": "Id",
          "type": "string"
        }
      },
      "title": "FactionProps",
      "type": "object"
    },
    "HealthProps": {
      "additionalProperties": false,
      "description": "Hit points for anything that can be damaged, including the player.",
      "properties": {
        "invuln_after_hit_s": {
          "default": 0.4,
          "description": "Invulnerability window after each hit. Contact damage is tested every frame, so without one a single touch empties a health bar in a few frames.",
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Invuln After Hit S",
          "type": "number"
        },
        "max": {
          "default": 100.0,
          "exclusiveMinimum": 0.0,
          "maximum": 100000.0,
          "title": "Max",
          "type": "number"
        }
      },
      "title": "HealthProps",
      "type": "object"
    },
    "LightSpec": {
      "additionalProperties": false,
      "properties": {
        "color_rgb": {
          "items": {
            "type": "number"
          },
          "title": "Color Rgb",
          "type": "array"
        },
        "id": {
          "description": "Snake-case identifier, max 64 chars.",
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "intensity": {
          "default": 1.0,
          "maximum": 20.0,
          "minimum": 0.0,
          "title": "Intensity",
          "type": "number"
        },
        "kind": {
          "default": "directional",
          "maxLength": 32,
          "title": "Kind",
          "type": "string"
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        }
      },
      "required": [
        "id"
      ],
      "title": "LightSpec",
      "type": "object"
    },
    "MechanicBinding": {
      "additionalProperties": false,
      "properties": {
        "mechanic_id": {
          "description": "Either 'builtin.<name>' for a reusable mechanic or 'generated.<code_task_id>' for a generated module.",
          "maxLength": 128,
          "title": "Mechanic Id",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "mechanic_id"
      ],
      "title": "MechanicBinding",
      "type": "object"
    },
    "MeshRef": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "description": "Snake-case identifier, max 64 chars.",
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
          "title": "Asset Id",
          "type": "string"
        },
        "glb_path": {
          "description": "Project-relative path under projects/<id>/assets/",
          "maxLength": 512,
          "title": "Glb Path",
          "type": "string"
        },
        "sockets": {
          "additionalProperties": {
            "$ref": "#/$defs/SocketRef"
          },
          "description": "Named attachment points (e.g. 'muzzle', 'grip') in metres, relative to the mesh origin. Populated by the scene compiler from asset_contract.json; the SceneSpec agent leaves this empty.",
          "title": "Sockets",
          "type": "object"
        }
      },
      "required": [
        "asset_id",
        "glb_path"
      ],
      "title": "MeshRef",
      "type": "object"
    },
    "PhysicsProps": {
      "additionalProperties": false,
      "properties": {
        "collision_shape": {
          "default": "aabb",
          "maxLength": 32,
          "title": "Collision Shape",
          "type": "string"
        },
        "friction": {
          "default": 0.5,
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Friction",
          "type": "number"
        },
        "kind": {
          "default": "static",
          "maxLength": 32,
          "title": "Kind",
          "type": "string"
        },
        "mass_kg": {
          "default": 1.0,
          "exclusiveMaximum": 10000.0,
          "minimum": 0.0,
          "title": "Mass Kg",
          "type": "number"
        },
        "restitution": {
          "default": 0.2,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Restitution",
          "type": "number"
        }
      },
      "title": "PhysicsProps",
      "type": "object"
    },
    "PlayerSpawn": {
      "additionalProperties": false,
      "properties": {
        "face_direction": {
          "$ref": "#/$defs/Vec3"
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        }
      },
      "title": "PlayerSpawn",
      "type": "object"
    },
    "QuatXYZW": {
      "additionalProperties": false,
      "description": "Quaternion stored as (x, y, z, w), identity = (0,0,0,1).",
      "properties": {
        "w": {
          "default": 1.0,
          "title": "W",
          "type": "number"
        },
        "x": {
          "default": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.0,
          "title": "Y",
          "type": "number"
        },
        "z": {
          "default": 0.0,
          "title": "Z",
          "type": "number"
        }
      },
      "title": "QuatXYZW",
      "type": "object"
    },
    "SocketRef": {
      "additionalProperties": false,
      "description": "A named attachment point in the mesh's own local space.\n\nDerived deterministically from geometry by the ``asset_contract`` stage\nand converted from unit space to metres by the scene compiler, so the\nruntime can just compose ``entity_transform * socket``.",
      "properties": {
        "position": {
          "$ref": "#/$defs/Vec3"
        },
        "rotation": {
          "$ref": "#/$defs/QuatXYZW"
        }
      },
      "title": "SocketRef",
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/Vec3"
        },
        "rotation": {
          "$ref": "#/$defs/QuatXYZW"
        },
        "scale": {
          "default": 1.0,
          "exclusiveMaximum": 1000.0,
          "exclusiveMinimum": 0.0,
          "title": "Scale",
          "type": "number"
        }
      },
      "title": "Transform",
      "type": "object"
    },
    "Vec3": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.0,
          "title": "Y",
          "type": "number"
        },
        "z": {
          "default": 0.0,
          "title": "Z",
          "type": "number"
        }
      },
      "title": "Vec3",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ambient_intensity": {
      "default": 0.25,
      "maximum": 5.0,
      "minimum": 0.0,
      "title": "Ambient Intensity",
      "type": "number"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/EntitySpec"
      },
      "maxItems": 1000,
      "minItems": 0,
      "title": "Entities",
      "type": "array"
    },
    "lights": {
      "items": {
        "$ref": "#/$defs/LightSpec"
      },
      "maxItems": 32,
      "title": "Lights",
      "type": "array"
    },
    "name": {
      "maxLength": 128,
      "title": "Name",
      "type": "string"
    },
    "player_spawn": {
      "$ref": "#/$defs/PlayerSpawn"
    },
    "prompt_id": {
      "description": "Snake-case identifier, max 64 chars.",
      "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
      "title": "Prompt Id",
      "type": "string"
    },
    "scene_id": {
      "description": "Snake-case identifier, max 64 chars.",
      "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
      "title": "Scene Id",
      "type": "string"
    },
    "sky_color": {
      "items": {
        "type": "number"
      },
      "title": "Sky Color",
      "type": "array"
    }
  },
  "required": [
    "prompt_id",
    "scene_id",
    "name",
    "entities"
  ],
  "title": "SceneSpec",
  "type": "object"
}
