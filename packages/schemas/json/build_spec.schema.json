{
  "$defs": {
    "AssetEntry": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "maxLength": 32,
          "title": "Category",
          "type": "string"
        },
        "id": {
          "description": "Snake-case identifier, max 64 chars.",
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        },
        "summary": {
          "maxLength": 4000,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "summary"
      ],
      "title": "AssetEntry",
      "type": "object"
    },
    "ComfortLevel": {
      "enum": [
        "comfort",
        "standard",
        "intense"
      ],
      "title": "ComfortLevel",
      "type": "string"
    },
    "GameType": {
      "enum": [
        "arcade",
        "adventure",
        "puzzle",
        "simulation",
        "shooter",
        "sandbox",
        "narrative",
        "experience"
      ],
      "title": "GameType",
      "type": "string"
    },
    "LocomotionStyle": {
      "enum": [
        "teleport",
        "smooth",
        "mixed",
        "stationary"
      ],
      "title": "LocomotionStyle",
      "type": "string"
    },
    "MechanicEntry": {
      "additionalProperties": false,
      "properties": {
        "depends_on_assets": {
          "items": {
            "description": "Snake-case identifier, max 64 chars.",
            "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
            "type": "string"
          },
          "title": "Depends On Assets",
          "type": "array"
        },
        "id": {
          "description": "Snake-case identifier, max 64 chars.",
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        },
        "required_in_scenes": {
          "items": {
            "description": "Snake-case identifier, max 64 chars.",
            "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
            "type": "string"
          },
          "title": "Required In Scenes",
          "type": "array"
        },
        "summary": {
          "maxLength": 4000,
          "title": "Summary",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/MechanicType",
          "default": "regular"
        }
      },
      "required": [
        "id",
        "name",
        "summary"
      ],
      "title": "MechanicEntry",
      "type": "object"
    },
    "MechanicType": {
      "description": "Whether a mechanic is a self-contained behavior or a shared foundation.\n\n* ``regular`` \u2014 a closed input -> action loop (e.g. \"press A to jump\",\n  \"grab an object\", \"take damage\"). Most mechanics are regular.\n* ``hub`` \u2014 a shared foundation that OTHER mechanics build on and branch\n  from (e.g. a ``shooting_hub`` that detects a held weapon + the correct\n  hand's trigger, which the per-weapon blast profiles then extend). The\n  BuildSpec only labels the type; downstream stages (MechanicPlan /\n  CodeTask) decide the concrete dependency edges.",
      "enum": [
        "regular",
        "hub"
      ],
      "title": "MechanicType",
      "type": "string"
    },
    "SceneEntry": {
      "additionalProperties": false,
      "properties": {
        "entry_point": {
          "default": false,
          "title": "Entry Point",
          "type": "boolean"
        },
        "expected_playtime_minutes": {
          "default": 5.0,
          "maximum": 240.0,
          "minimum": 0.5,
          "title": "Expected Playtime Minutes",
          "type": "number"
        },
        "id": {
          "description": "Snake-case identifier, max 64 chars.",
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        },
        "summary": {
          "maxLength": 4000,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "summary"
      ],
      "title": "SceneEntry",
      "type": "object"
    },
    "TestEntry": {
      "additionalProperties": false,
      "properties": {
        "automated": {
          "default": false,
          "title": "Automated",
          "type": "boolean"
        },
        "description": {
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "description": "Snake-case identifier, max 64 chars.",
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "TestEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Top-level specification for a generation run.\n\nSizing notes (updated for full VR-game generation):\n\n* ``scenes``  \u2014 1..50. Many prompts describe hub + multiple mission\n  / training / arena spaces, so we lift the cap from 6 -> 50.\n* ``mechanics`` \u2014 1..unbounded. A fully detailed VR game can call\n  for dozens of distinct mechanics (movement, combat, abilities,\n  UI, save / load, NPC interaction, etc.). The planner is\n  responsible for keeping the list realistic.\n* ``assets`` \u2014 1..48. Per-game asset budgets are still bounded by\n  the Tripo / Gemini cost ceiling; this matches the AssetManifest\n  cap.\n* ``acceptance_tests`` \u2014 1..unbounded. The number of checks scales\n  with the number of mechanics.\n* ``constraints`` \u2014 up to 50 free-form rules (raised from 32).",
  "properties": {
    "acceptance_tests": {
      "items": {
        "$ref": "#/$defs/TestEntry"
      },
      "minItems": 1,
      "title": "Acceptance Tests",
      "type": "array"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetEntry"
      },
      "maxItems": 48,
      "minItems": 1,
      "title": "Assets",
      "type": "array"
    },
    "comfort": {
      "$ref": "#/$defs/ComfortLevel",
      "default": "comfort"
    },
    "constraints": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Constraints",
      "type": "array"
    },
    "game_type": {
      "$ref": "#/$defs/GameType"
    },
    "hud_summary": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hud Summary"
    },
    "locomotion": {
      "$ref": "#/$defs/LocomotionStyle",
      "default": "teleport"
    },
    "mechanics": {
      "items": {
        "$ref": "#/$defs/MechanicEntry"
      },
      "minItems": 1,
      "title": "Mechanics",
      "type": "array"
    },
    "npc_summary": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Npc Summary"
    },
    "pitch": {
      "maxLength": 2000,
      "title": "Pitch",
      "type": "string"
    },
    "player_height_meters": {
      "default": 1.7,
      "exclusiveMaximum": 3.0,
      "exclusiveMinimum": 0.0,
      "title": "Player Height Meters",
      "type": "number"
    },
    "prompt_id": {
      "description": "Snake-case identifier, max 64 chars.",
      "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
      "title": "Prompt Id",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/SceneEntry"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "title": {
      "maxLength": 128,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "prompt_id",
    "title",
    "pitch",
    "game_type",
    "scenes",
    "mechanics",
    "assets",
    "acceptance_tests"
  ],
  "title": "BuildSpec",
  "type": "object"
}
