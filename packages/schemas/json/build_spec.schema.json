{
  "$defs": {
    "AssetEntry": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "maxLength": 32,
          "title": "Category",
          "type": "string"
        },
        "id": {
          "description": "Snake-case identifier, max 64 chars.",
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "summary"
      ],
      "title": "AssetEntry",
      "type": "object"
    },
    "ComfortLevel": {
      "enum": [
        "comfort",
        "standard",
        "intense"
      ],
      "title": "ComfortLevel",
      "type": "string"
    },
    "GameType": {
      "enum": [
        "arcade",
        "adventure",
        "puzzle",
        "simulation",
        "shooter",
        "sandbox",
        "narrative",
        "experience"
      ],
      "title": "GameType",
      "type": "string"
    },
    "LocomotionStyle": {
      "enum": [
        "teleport",
        "smooth",
        "mixed",
        "stationary"
      ],
      "title": "LocomotionStyle",
      "type": "string"
    },
    "MechanicEntry": {
      "additionalProperties": false,
      "properties": {
        "depends_on_assets": {
          "items": {
            "description": "Snake-case identifier, max 64 chars.",
            "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
            "type": "string"
          },
          "title": "Depends On Assets",
          "type": "array"
        },
        "id": {
          "description": "Snake-case identifier, max 64 chars.",
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        },
        "required_in_scenes": {
          "items": {
            "description": "Snake-case identifier, max 64 chars.",
            "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
            "type": "string"
          },
          "title": "Required In Scenes",
          "type": "array"
        },
        "summary": {
          "maxLength": 2000,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "summary"
      ],
      "title": "MechanicEntry",
      "type": "object"
    },
    "SceneEntry": {
      "additionalProperties": false,
      "properties": {
        "entry_point": {
          "default": false,
          "title": "Entry Point",
          "type": "boolean"
        },
        "expected_playtime_minutes": {
          "default": 5.0,
          "maximum": 240.0,
          "minimum": 0.5,
          "title": "Expected Playtime Minutes",
          "type": "number"
        },
        "id": {
          "description": "Snake-case identifier, max 64 chars.",
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "summary"
      ],
      "title": "SceneEntry",
      "type": "object"
    },
    "TestEntry": {
      "additionalProperties": false,
      "properties": {
        "automated": {
          "default": false,
          "title": "Automated",
          "type": "boolean"
        },
        "description": {
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "description": "Snake-case identifier, max 64 chars.",
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "TestEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Top-level specification for a generation run.",
  "properties": {
    "acceptance_tests": {
      "items": {
        "$ref": "#/$defs/TestEntry"
      },
      "maxItems": 24,
      "minItems": 1,
      "title": "Acceptance Tests",
      "type": "array"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetEntry"
      },
      "maxItems": 48,
      "minItems": 1,
      "title": "Assets",
      "type": "array"
    },
    "comfort": {
      "$ref": "#/$defs/ComfortLevel",
      "default": "comfort"
    },
    "constraints": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Constraints",
      "type": "array"
    },
    "game_type": {
      "$ref": "#/$defs/GameType"
    },
    "hud_summary": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hud Summary"
    },
    "locomotion": {
      "$ref": "#/$defs/LocomotionStyle",
      "default": "teleport"
    },
    "mechanics": {
      "items": {
        "$ref": "#/$defs/MechanicEntry"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Mechanics",
      "type": "array"
    },
    "npc_summary": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Npc Summary"
    },
    "pitch": {
      "maxLength": 2000,
      "title": "Pitch",
      "type": "string"
    },
    "player_height_meters": {
      "default": 1.7,
      "exclusiveMaximum": 3.0,
      "exclusiveMinimum": 0.0,
      "title": "Player Height Meters",
      "type": "number"
    },
    "prompt_id": {
      "description": "Snake-case identifier, max 64 chars.",
      "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
      "title": "Prompt Id",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/SceneEntry"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "title": {
      "maxLength": 128,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "prompt_id",
    "title",
    "pitch",
    "game_type",
    "scenes",
    "mechanics",
    "assets",
    "acceptance_tests"
  ],
  "title": "BuildSpec",
  "type": "object"
}
