{
  "$defs": {
    "PlayerExperience": {
      "description": "What the player IS in the game. Chosen by the user at project\ncreation, not by the model -- like ``target_device``.\n\n* ``hands_only`` -- the player is a pair of hands: the engine's default\n  rigged hands, no body, no head mesh. No full-body avatar asset is\n  planned or generated. Hand-shaped gameplay props (gloves, gauntlets)\n  are still generated as ordinary props.\n* ``full_avatar`` -- the player has a full GLB body generated by the\n  pipeline (reference image -> Tripo -> rig), viewed first person, whose\n  own hands are the player's hands.",
      "enum": [
        "hands_only",
        "full_avatar"
      ],
      "title": "PlayerExperience",
      "type": "string"
    },
    "ProjectStage": {
      "enum": [
        "created",
        "build_spec",
        "asset_manifest",
        "npc_plan",
        "game_design",
        "mechanic_plan",
        "scene_spec",
        "reference_images",
        "tripo_models",
        "character_routing",
        "uthana_rigging",
        "asset_rigging",
        "asset_animation",
        "uthana_motion_plan",
        "uthana_animation",
        "asset_normalization",
        "asset_contract",
        "asset_optimization",
        "code_generation",
        "world_generation",
        "scene_compile",
        "cmake_configure",
        "cmake_build",
        "quest_build",
        "quest_runtime_verify",
        "quest_install",
        "engine_promotion",
        "ready_to_launch",
        "failed"
      ],
      "title": "ProjectStage",
      "type": "string"
    },
    "ProjectStatus": {
      "enum": [
        "idle",
        "running",
        "paused",
        "succeeded",
        "failed",
        "aborted"
      ],
      "title": "ProjectStatus",
      "type": "string"
    },
    "StageRecord": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/ProjectStage"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "$ref": "#/$defs/ProjectStatus"
        }
      },
      "required": [
        "stage",
        "status"
      ],
      "title": "StageRecord",
      "type": "object"
    },
    "TargetDevice": {
      "description": "Which VR target the generated game is built and launched for.\n\n* ``pcvr`` \u2014 Windows native ``.exe`` (Vulkan + Win32 OpenXR), run on the\n  PC and viewed on the headset over Quest Link. The historical default.\n* ``quest`` \u2014 a standalone Android APK (Vulkan + Android OpenXR loader,\n  NativeActivity) installed and run locally on the Quest headset.\n\nStages 1-9 (BuildSpec .. scene compile, incl. codegen + worldgen) are\nidentical for both; only the build + launch stages branch on this value.",
      "enum": [
        "pcvr",
        "quest"
      ],
      "title": "TargetDevice",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "current_stage": {
      "$ref": "#/$defs/ProjectStage",
      "default": "created"
    },
    "env_snapshot": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Env Snapshot",
      "type": "object"
    },
    "latest_build_apk": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Build Apk"
    },
    "latest_build_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Build Dir"
    },
    "latest_build_exe": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Build Exe"
    },
    "latest_scene_json": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Scene Json"
    },
    "player_experience": {
      "$ref": "#/$defs/PlayerExperience",
      "default": "full_avatar"
    },
    "project_id": {
      "description": "Snake-case identifier, max 64 chars.",
      "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "prompt": {
      "maxLength": 16000,
      "title": "Prompt",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageRecord"
      },
      "title": "Stages",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ProjectStatus",
      "default": "idle"
    },
    "target_device": {
      "$ref": "#/$defs/TargetDevice",
      "default": "pcvr"
    },
    "title": {
      "maxLength": 128,
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "title",
    "prompt"
  ],
  "title": "ProjectState",
  "type": "object"
}
