{
  "$defs": {
    "CheckOutcome": {
      "enum": [
        "pass",
        "fail",
        "not_applicable",
        "warning"
      ],
      "title": "CheckOutcome",
      "type": "string"
    },
    "MemoryReport": {
      "additionalProperties": false,
      "description": "Quest 3 memory: Meta's 5.75 GiB PSS limit versus the engine's own\n4.5 GiB steady-state target and 5.0 GiB peak ceiling.",
      "properties": {
        "ceiling_mb": {
          "default": 5120.0,
          "title": "Ceiling Mb",
          "type": "number"
        },
        "compromises": {
          "items": {
            "type": "string"
          },
          "title": "Compromises",
          "type": "array"
        },
        "estimated_peak_mb": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Peak Mb"
        },
        "estimated_steady_mb": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Steady Mb"
        },
        "leak_mb_per_cycle": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Leak Mb Per Cycle"
        },
        "limit_mb": {
          "default": 5888.0,
          "title": "Limit Mb",
          "type": "number"
        },
        "low_memory_kills": {
          "items": {
            "type": "string"
          },
          "title": "Low Memory Kills",
          "type": "array"
        },
        "measured": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Measured",
          "type": "object"
        },
        "measured_peak_mb": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Peak Mb"
        },
        "measured_steady_mb": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Steady Mb"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/MemoryStatus"
        },
        "target_mb": {
          "default": 4608.0,
          "title": "Target Mb",
          "type": "number"
        }
      },
      "required": [
        "status"
      ],
      "title": "MemoryReport",
      "type": "object"
    },
    "MemoryStatus": {
      "enum": [
        "verified_safe",
        "estimated_safe_not_device_tested",
        "at_risk",
        "failed_on_device"
      ],
      "title": "MemoryStatus",
      "type": "string"
    },
    "VerificationCheck": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "default": "base",
          "maxLength": 32,
          "title": "Category",
          "type": "string"
        },
        "detail": {
          "default": "",
          "maxLength": 2000,
          "title": "Detail",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence",
          "type": "array"
        },
        "name": {
          "maxLength": 120,
          "title": "Name",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/CheckOutcome"
        },
        "subject": {
          "default": "",
          "maxLength": 120,
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "name",
        "outcome"
      ],
      "title": "VerificationCheck",
      "type": "object"
    },
    "VerificationStatus": {
      "enum": [
        "passed",
        "failed",
        "skipped"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capture_seconds": {
      "default": 0.0,
      "title": "Capture Seconds",
      "type": "number"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/VerificationCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "device_serial": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Device Serial"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "log_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Log Path"
    },
    "memory": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemoryReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "npc_summary": {
      "default": "",
      "maxLength": 500,
      "title": "Npc Summary",
      "type": "string"
    },
    "package": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package"
    },
    "performance": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Performance",
      "type": "object"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "reason": {
      "default": "",
      "maxLength": 2000,
      "title": "Reason",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/VerificationStatus"
    }
  },
  "required": [
    "project_id",
    "status"
  ],
  "title": "RuntimeVerification",
  "type": "object"
}
