{
  "$defs": {
    "CheckOutcome": {
      "enum": [
        "pass",
        "fail",
        "not_applicable"
      ],
      "title": "CheckOutcome",
      "type": "string"
    },
    "VerificationCheck": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "default": "base",
          "maxLength": 32,
          "title": "Category",
          "type": "string"
        },
        "detail": {
          "default": "",
          "maxLength": 2000,
          "title": "Detail",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence",
          "type": "array"
        },
        "name": {
          "maxLength": 120,
          "title": "Name",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/CheckOutcome"
        },
        "subject": {
          "default": "",
          "maxLength": 120,
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "name",
        "outcome"
      ],
      "title": "VerificationCheck",
      "type": "object"
    },
    "VerificationStatus": {
      "enum": [
        "passed",
        "failed",
        "skipped"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capture_seconds": {
      "default": 0.0,
      "title": "Capture Seconds",
      "type": "number"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/VerificationCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "device_serial": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Device Serial"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "log_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Log Path"
    },
    "npc_summary": {
      "default": "",
      "maxLength": 500,
      "title": "Npc Summary",
      "type": "string"
    },
    "package": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "reason": {
      "default": "",
      "maxLength": 2000,
      "title": "Reason",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/VerificationStatus"
    }
  },
  "required": [
    "project_id",
    "status"
  ],
  "title": "RuntimeVerification",
  "type": "object"
}
