{
  "$defs": {
    "AssetCategory": {
      "enum": [
        "environment",
        "prop",
        "character",
        "fx",
        "ui"
      ],
      "title": "AssetCategory",
      "type": "string"
    },
    "AssetImportance": {
      "description": "How much of the triangle budget an asset deserves.\n\n``hero`` assets are the ones the player looks at up close (characters,\nheld/interactive objects). ``background`` assets are set dressing seen at\na distance. Derived from category/scale/interactivity when not authored.",
      "enum": [
        "hero",
        "standard",
        "background"
      ],
      "title": "AssetImportance",
      "type": "string"
    },
    "AssetItem": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/AssetCategory"
        },
        "collision_shape": {
          "default": "aabb",
          "description": "Deterministic collision primitive: 'aabb', 'sphere', 'capsule', or 'mesh' (from GLB).",
          "maxLength": 32,
          "title": "Collision Shape",
          "type": "string"
        },
        "id": {
          "description": "Snake-case identifier, max 64 chars.",
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "importance": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetImportance"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How much of the triangle budget this asset deserves. 'hero' for things inspected up close (characters, held props), 'background' for distant set dressing. Derived when omitted."
        },
        "max_triangles": {
          "anyOf": [
            {
              "maximum": 200000,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hard per-asset triangle cap after decimation. Overrides the budget allocator for this asset when set.",
          "title": "Max Triangles"
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/ReferenceImageRequest"
        },
        "rigged": {
          "default": false,
          "title": "Rigged",
          "type": "boolean"
        },
        "socket_hints": {
          "description": "Named attachment points gameplay will need on this asset, e.g. ['muzzle', 'grip'] for a weapon. The deterministic asset_contract stage derives their transforms from the geometry and the scene compiler writes them into scene.json, so generated C++ can fire from the barrel tip via ctx.sockets->socket_world(self, 'muzzle') without ever inspecting the mesh. Leave empty for scenery and any asset no mechanic attaches to.",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Socket Hints",
          "type": "array"
        },
        "strategy": {
          "$ref": "#/$defs/GenerationStrategy",
          "default": "image_to_3d"
        },
        "style_notes": {
          "maxLength": 2000,
          "title": "Style Notes",
          "type": "string"
        },
        "target_scale_meters": {
          "default": 1.0,
          "exclusiveMaximum": 30.0,
          "exclusiveMinimum": 0.0,
          "title": "Target Scale Meters",
          "type": "number"
        },
        "tripo": {
          "$ref": "#/$defs/TripoRequest"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "style_notes",
        "reference"
      ],
      "title": "AssetItem",
      "type": "object"
    },
    "GenerationStrategy": {
      "enum": [
        "image_to_3d",
        "text_to_3d"
      ],
      "title": "GenerationStrategy",
      "type": "string"
    },
    "ReferenceImageRequest": {
      "additionalProperties": false,
      "description": "Reference image parameters sent to Gemini / Imagen.\n\n``number_of_images`` is intentionally pinned to 1: nothing in the\npipeline currently ranks / chooses between multiple candidate\nreference images for the same asset (the Tripo stage picks the\nfirst alphabetically). Allowing >1 just burns API credits with no\nquality benefit, so we cap the request at one image per asset\nuntil a real selection step exists.",
      "properties": {
        "aspect_ratio": {
          "default": "1:1",
          "pattern": "^\\d{1,2}:\\d{1,2}$",
          "title": "Aspect Ratio",
          "type": "string"
        },
        "negative_prompt": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Negative Prompt"
        },
        "number_of_images": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Number Of Images",
          "type": "integer"
        },
        "prompt": {
          "maxLength": 4000,
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "ReferenceImageRequest",
      "type": "object"
    },
    "TripoRequest": {
      "additionalProperties": false,
      "description": "Shape of the Tripo image-to-3D / text-to-3D request.\n\nTextured, PBR, image-aligned defaults are REQUIRED per project policy.",
      "properties": {
        "face_limit": {
          "anyOf": [
            {
              "maximum": 50000,
              "minimum": 64,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Face Limit"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional explicit model version (e.g. 'v2.5-20250123', 'p1'). When None the client uses its default.",
          "title": "Model Version"
        },
        "pbr": {
          "default": true,
          "title": "Pbr",
          "type": "boolean"
        },
        "texture": {
          "default": true,
          "title": "Texture",
          "type": "boolean"
        },
        "texture_alignment": {
          "$ref": "#/$defs/TripoTextureAlignment",
          "default": "original_image"
        },
        "texture_quality": {
          "$ref": "#/$defs/TripoTextureQuality",
          "default": "detailed"
        }
      },
      "title": "TripoRequest",
      "type": "object"
    },
    "TripoTextureAlignment": {
      "enum": [
        "original_image",
        "geometry"
      ],
      "title": "TripoTextureAlignment",
      "type": "string"
    },
    "TripoTextureQuality": {
      "enum": [
        "standard",
        "detailed"
      ],
      "title": "TripoTextureQuality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/AssetItem"
      },
      "maxItems": 48,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "prompt_id": {
      "description": "Snake-case identifier, max 64 chars.",
      "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
      "title": "Prompt Id",
      "type": "string"
    }
  },
  "required": [
    "prompt_id",
    "items"
  ],
  "title": "AssetManifest",
  "type": "object"
}
